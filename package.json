{
  "name": "mdijkstra-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n logos,site -c magenta,cyan \"npm:logos\" \"npm:dev\"",
    "logos": "cd ../../hermes/hermes-logos && make dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "jsdom": "^29.1.1",
    "typescript": "5.6",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
